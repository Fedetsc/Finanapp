generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}

enum AccountType {
  BANK
  SAVINGS
  PAYROLL
  WALLET
  CASH
  INVESTMENT
}

enum SavingsMovementType {
  DEPOSIT
  WITHDRAW
}

enum SubscriptionCycle {
  WEEKLY
  MONTHLY
  YEARLY
}

enum PurchaseStatus {
  ACTIVE
  PAID
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  AWAITING_CONFIRMATION
  PAID
}

model Household {
  id            String               @id @default(uuid())
  name          String
  currency      String               @default("ARS")
  inviteCode    String               @unique @default(uuid())
  createdAt     DateTime             @default(now())
  members       Member[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  subscriptions Subscription[]
  creditCards   CreditCard[]
  cardPurchases CreditCardPurchase[]
  savingsVaults SavingsVault[]
  savingsMoves  SavingsMovement[]
}

model Member {
  id            String               @id @default(uuid())
  /// Un usuario puede ser miembro de varios hogares (uno por hogar).
  userId        String
  householdId   String
  name          String
  role          String               @default("MEMBER")
  createdAt     DateTime             @default(now())
  household     Household            @relation(fields: [householdId], references: [id])
  transactions  Transaction[]
  accounts      Account[]
  subscriptions Subscription[]
  creditCards   CreditCard[]
  cardPurchases CreditCardPurchase[]
  savingsVaults SavingsVault[]
  savingsMoves  SavingsMovement[]

  @@unique([userId, householdId])
  @@index([userId])
  @@index([householdId])
}

model Account {
  id               String            @id @default(uuid())
  householdId      String
  ownerMemberId    String
  name             String
  type             AccountType
  /// Código de moneda: ARS, USD, USD_MEP, EUR u otro escrito por el usuario. Saldos y movimientos van en esta moneda.
  currency         String            @default("ARS")
  openingBalance   BigInt            @default(0)
  createdAt        DateTime          @default(now())
  household        Household         @relation(fields: [householdId], references: [id])
  owner            Member            @relation(fields: [ownerMemberId], references: [id])
  transactions     Transaction[]     @relation("TxAccount")
  transfersIn      Transaction[]     @relation("TxToAccount")
  subscriptions    Subscription[]
  paidInstallments Installment[]
  savingsMoves     SavingsMovement[]

  @@index([householdId])
  @@index([ownerMemberId])
}

model Category {
  id           String        @id @default(uuid())
  householdId  String
  name         String
  household    Household     @relation(fields: [householdId], references: [id])
  transactions Transaction[]

  @@unique([householdId, name])
}

model Transaction {
  id             String        @id @default(uuid())
  householdId    String
  memberId       String
  accountId      String
  /// Solo en TRANSFER: cuenta destino (accountId es el origen).
  toAccountId    String?
  /// Null en TRANSFER: las transferencias no llevan categoría.
  categoryId     String?
  type           TxType
  /// En la moneda de la cuenta origen (accountId).
  amount         BigInt
  /// Solo en TRANSFER: monto acreditado en la cuenta destino, en su moneda. Null en transferencias viejas (= amount).
  toAmount       BigInt?
  /// Solo en TRANSFER entre monedas distintas: tipo de cambio que cargó el usuario.
  /// Si una de las dos es ARS: pesos por 1 unidad de la otra moneda. Si no: unidades de destino por 1 de origen.
  exchangeRate   Decimal?      @db.Decimal(20, 6)
  date           DateTime      @db.Date
  description    String        @default("")
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  household      Household     @relation(fields: [householdId], references: [id])
  member         Member        @relation(fields: [memberId], references: [id])
  account        Account       @relation("TxAccount", fields: [accountId], references: [id])
  toAccount      Account?      @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Cobro automático de una suscripción (único por suscripción + fecha: evita duplicados).
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// Pago de una cuota de tarjeta (una cuota no se puede pagar dos veces).
  installmentId  String?       @unique
  installment    Installment?  @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, date])
  @@index([householdId, date])
  @@index([toAccountId])
  @@index([accountId])
  @@index([memberId])
  @@index([categoryId])
}

/// Montos en centavos, como Account y Transaction.
model Subscription {
  id              String            @id @default(uuid())
  householdId     String
  /// Quien la creó y dueño de la cuenta adherida.
  memberId        String
  name            String
  amount          BigInt
  currency        String            @default("ARS")
  cycle           SubscriptionCycle
  nextPaymentDate DateTime          @db.Date
  accountId       String
  isActive        Boolean           @default(true)
  lastChargedDate DateTime?         @db.Date
  createdAt       DateTime          @default(now())
  household       Household         @relation(fields: [householdId], references: [id])
  member          Member            @relation(fields: [memberId], references: [id])
  account         Account           @relation(fields: [accountId], references: [id])
  charges         Transaction[]

  @@index([householdId, isActive, nextPaymentDate])
  @@index([accountId])
}

model CreditCard {
  id            String               @id @default(uuid())
  householdId   String
  ownerMemberId String
  name          String
  bank          String
  last4         String?
  limit         BigInt
  closingDay    Int
  dueDay        Int
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  household     Household            @relation(fields: [householdId], references: [id])
  owner         Member               @relation(fields: [ownerMemberId], references: [id])
  purchases     CreditCardPurchase[]

  @@index([householdId])
}

model CreditCardPurchase {
  id                String         @id @default(uuid())
  cardId            String
  householdId       String
  memberId          String
  description       String
  totalAmount       BigInt
  installmentsCount Int
  installmentsPaid  Int            @default(0)
  purchaseDate      DateTime       @db.Date
  status            PurchaseStatus @default(ACTIVE)
  createdAt         DateTime       @default(now())
  card              CreditCard     @relation(fields: [cardId], references: [id])
  household         Household      @relation(fields: [householdId], references: [id])
  member            Member         @relation(fields: [memberId], references: [id])
  installments      Installment[]

  @@index([cardId])
  @@index([householdId])
  @@index([memberId])
}

model Installment {
  id                String             @id @default(uuid())
  purchaseId        String
  number            Int
  amount            BigInt
  /// Cierre del resumen en el que entra la cuota: después de esta fecha pasa a AWAITING_CONFIRMATION.
  closingDate       DateTime           @db.Date
  dueDate           DateTime           @db.Date
  status            InstallmentStatus  @default(PENDING)
  paidWithAccountId String?
  paidAt            DateTime?
  purchase          CreditCardPurchase @relation(fields: [purchaseId], references: [id])
  paidWithAccount   Account?           @relation(fields: [paidWithAccountId], references: [id])
  transaction       Transaction?

  @@unique([purchaseId, number])
  @@index([status, closingDate])
}

model AuditLog {
  id          String   @id @default(uuid())
  householdId String
  userId      String
  action      String
  entity      String
  entityId    String
  createdAt   DateTime @default(now())

  @@index([householdId, createdAt])
}

/// Ahorro apartado ("sobre"). Montos en centavos. currentAmount = depósitos - retiros.
model SavingsVault {
  id            String            @id @default(uuid())
  householdId   String
  /// Quien lo creó: el único que puede apartar y retirar.
  memberId      String
  name          String
  targetAmount  BigInt?
  currentAmount BigInt            @default(0)
  emoji         String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  household     Household         @relation(fields: [householdId], references: [id])
  member        Member            @relation(fields: [memberId], references: [id])
  movements     SavingsMovement[]

  @@unique([householdId, name])
}

/// Apartar (DEPOSIT: cuenta -> sobre) o retirar (WITHDRAW: sobre -> cuenta). No es ingreso ni gasto.
model SavingsMovement {
  id          String              @id @default(uuid())
  vaultId     String
  householdId String
  memberId    String
  accountId   String
  type        SavingsMovementType
  amount      BigInt
  date        DateTime            @db.Date
  description String              @default("")
  createdAt   DateTime            @default(now())
  vault       SavingsVault        @relation(fields: [vaultId], references: [id])
  household   Household           @relation(fields: [householdId], references: [id])
  member      Member              @relation(fields: [memberId], references: [id])
  account     Account             @relation(fields: [accountId], references: [id])

  @@index([vaultId, date])
  @@index([accountId])
  @@index([householdId])
}
