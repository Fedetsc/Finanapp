generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
  /// Rendimiento diario acreditado automáticamente (suma al saldo; no cuenta como ingreso del mes).
  YIELD
}

enum AccountType {
  BANK
  SAVINGS
  PAYROLL
  WALLET
  CASH
  INVESTMENT
}

enum SavingsMovementType {
  DEPOSIT
  WITHDRAW
}

enum SubscriptionCycle {
  WEEKLY
  MONTHLY
  YEARLY
}

enum PurchaseStatus {
  ACTIVE
  PAID
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  AWAITING_CONFIRMATION
  PAID
}

model Household {
  id                  String               @id @default(uuid())
  name                String
  currency            String               @default("ARS")
  inviteCode          String               @unique @default(uuid())
  createdAt           DateTime             @default(now())
  members             Member[]
  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  subscriptions       Subscription[]
  creditCards         CreditCard[]
  cardPurchases       CreditCardPurchase[]
  savingsVaults       SavingsVault[]
  savingsMoves        SavingsMovement[]
  exchangeRates       ExchangeRate[]
  subscriptionChanges SubscriptionChange[]
  monthlyGoals        MonthlyGoal[]
  splitGroups         SplitGroup[]
  mpConnections       MpConnection[]
}

model Member {
  id                String               @id @default(uuid())
  /// Un usuario puede ser miembro de varios hogares (uno por hogar).
  userId            String
  householdId       String
  name              String
  role              String               @default("MEMBER")
  createdAt         DateTime             @default(now())
  household         Household            @relation(fields: [householdId], references: [id])
  transactions      Transaction[]
  accounts          Account[]
  subscriptions     Subscription[]
  creditCards       CreditCard[]
  cardPurchases     CreditCardPurchase[]
  savingsVaults     SavingsVault[]
  savingsMoves      SavingsMovement[]
  monthlyGoals      MonthlyGoal[]
  splitParticipants SplitParticipant[]
  mpConnections     MpConnection[]

  @@unique([userId, householdId])
  @@index([userId])
  @@index([householdId])
}

model Account {
  id               String            @id @default(uuid())
  householdId      String
  ownerMemberId    String
  name             String
  type             AccountType
  /// Código de moneda: ARS, USD, USD_MEP, EUR u otro escrito por el usuario. Saldos y movimientos van en esta moneda.
  currency         String            @default("ARS")
  openingBalance   BigInt            @default(0)
  /// Rendimientos: si la cuenta genera interés diario (no aplica a CASH).
  yieldEnabled     Boolean           @default(false)
  /// TNA en % (ej. 35.5). Al cambiarla se usa desde la próxima acreditación; no se recalcula lo viejo.
  yieldAnnualRate  Decimal?          @db.Decimal(9, 4)
  /// false: el saldo ya trae los rendimientos (ej. Mercado Pago conectado), solo se muestran como informativos.
  yieldAutoAccrue  Boolean           @default(true)
  /// Último día acreditado (o el día en que se activó). La próxima acreditación es para el día siguiente.
  lastYieldAt      DateTime?         @db.Date
  createdAt        DateTime          @default(now())
  household        Household         @relation(fields: [householdId], references: [id])
  owner            Member            @relation(fields: [ownerMemberId], references: [id])
  transactions     Transaction[]     @relation("TxAccount")
  transfersIn      Transaction[]     @relation("TxToAccount")
  subscriptions    Subscription[]
  paidInstallments Installment[]
  savingsMoves     SavingsMovement[]
  mpConnection     MpConnection?

  @@index([householdId])
  @@index([ownerMemberId])
}

model Category {
  id           String        @id @default(uuid())
  householdId  String
  name         String
  household    Household     @relation(fields: [householdId], references: [id])
  transactions Transaction[]

  @@unique([householdId, name])
}

model Transaction {
  id             String        @id @default(uuid())
  householdId    String
  memberId       String
  accountId      String
  /// Solo en TRANSFER: cuenta destino (accountId es el origen).
  toAccountId    String?
  /// Null en TRANSFER: las transferencias no llevan categoría.
  categoryId     String?
  type           TxType
  /// En la moneda de la cuenta origen (accountId).
  amount         BigInt
  /// Solo en TRANSFER: monto acreditado en la cuenta destino, en su moneda. Null en transferencias viejas (= amount).
  toAmount       BigInt?
  /// Solo en TRANSFER entre monedas distintas: tipo de cambio que cargó el usuario.
  /// Si una de las dos es ARS: pesos por 1 unidad de la otra moneda. Si no: unidades de destino por 1 de origen.
  exchangeRate   Decimal?      @db.Decimal(20, 6)
  date           DateTime      @db.Date
  description    String        @default("")
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  household      Household     @relation(fields: [householdId], references: [id])
  member         Member        @relation(fields: [memberId], references: [id])
  account        Account       @relation("TxAccount", fields: [accountId], references: [id])
  toAccount      Account?      @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Cobro automático de una suscripción (único por suscripción + fecha: evita duplicados).
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// Pago de una cuota de tarjeta (una cuota no se puede pagar dos veces).
  installmentId  String?       @unique
  installment    Installment?  @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  /// Solo en YIELD: día acreditado. Único por cuenta: el mismo día no se acredita dos veces.
  yieldDate      DateTime?     @db.Date

  @@unique([subscriptionId, date])
  @@unique([accountId, yieldDate])
  @@index([householdId, date])
  @@index([toAccountId])
  @@index([accountId])
  @@index([memberId])
  @@index([categoryId])
}

/// Montos en centavos, como Account y Transaction.
model Subscription {
  id              String               @id @default(uuid())
  householdId     String
  /// Quien la creó y dueño de la cuenta adherida.
  memberId        String
  name            String
  amount          BigInt
  currency        String               @default("ARS")
  cycle           SubscriptionCycle
  nextPaymentDate DateTime             @db.Date
  accountId       String
  isActive        Boolean              @default(true)
  lastChargedDate DateTime?            @db.Date
  createdAt       DateTime             @default(now())
  household       Household            @relation(fields: [householdId], references: [id])
  member          Member               @relation(fields: [memberId], references: [id])
  account         Account              @relation(fields: [accountId], references: [id])
  charges         Transaction[]
  changes         SubscriptionChange[]

  @@index([householdId, isActive, nextPaymentDate])
  @@index([accountId])
}

/// Historial de cambios de monto (y de cuenta) de una suscripción. No crea movimientos.
model SubscriptionChange {
  id             String       @id @default(uuid())
  householdId    String
  subscriptionId String
  memberId       String
  oldAmount      BigInt
  newAmount      BigInt
  oldAccountId   String?
  newAccountId   String?
  note           String       @default("")
  createdAt      DateTime     @default(now())
  household      Household    @relation(fields: [householdId], references: [id])
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([householdId])
}

model CreditCard {
  id            String               @id @default(uuid())
  householdId   String
  ownerMemberId String
  name          String
  bank          String
  last4         String?
  limit         BigInt
  closingDay    Int
  dueDay        Int
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  household     Household            @relation(fields: [householdId], references: [id])
  owner         Member               @relation(fields: [ownerMemberId], references: [id])
  purchases     CreditCardPurchase[]

  @@index([householdId])
}

model CreditCardPurchase {
  id                String         @id @default(uuid())
  cardId            String
  householdId       String
  memberId          String
  description       String
  totalAmount       BigInt
  installmentsCount Int
  installmentsPaid  Int            @default(0)
  purchaseDate      DateTime       @db.Date
  status            PurchaseStatus @default(ACTIVE)
  createdAt         DateTime       @default(now())
  card              CreditCard     @relation(fields: [cardId], references: [id])
  household         Household      @relation(fields: [householdId], references: [id])
  member            Member         @relation(fields: [memberId], references: [id])
  installments      Installment[]

  @@index([cardId])
  @@index([householdId])
  @@index([memberId])
}

model Installment {
  id                String             @id @default(uuid())
  purchaseId        String
  number            Int
  amount            BigInt
  /// Cierre del resumen en el que entra la cuota: después de esta fecha pasa a AWAITING_CONFIRMATION.
  closingDate       DateTime           @db.Date
  dueDate           DateTime           @db.Date
  status            InstallmentStatus  @default(PENDING)
  paidWithAccountId String?
  paidAt            DateTime?
  purchase          CreditCardPurchase @relation(fields: [purchaseId], references: [id])
  paidWithAccount   Account?           @relation(fields: [paidWithAccountId], references: [id])
  transaction       Transaction?

  @@unique([purchaseId, number])
  @@index([status, closingDate])
}

model AuditLog {
  id          String   @id @default(uuid())
  householdId String
  userId      String
  action      String
  entity      String
  entityId    String
  createdAt   DateTime @default(now())

  @@index([householdId, createdAt])
}

/// Ahorro apartado ("sobre"). Montos en centavos. currentAmount = depósitos - retiros.
model SavingsVault {
  id            String            @id @default(uuid())
  householdId   String
  /// Quien lo creó: el único que puede apartar y retirar.
  memberId      String
  name          String
  targetAmount  BigInt?
  currentAmount BigInt            @default(0)
  emoji         String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  household     Household         @relation(fields: [householdId], references: [id])
  member        Member            @relation(fields: [memberId], references: [id])
  movements     SavingsMovement[]

  @@unique([householdId, name])
}

/// Apartar (DEPOSIT: cuenta -> sobre) o retirar (WITHDRAW: sobre -> cuenta). No es ingreso ni gasto.
model SavingsMovement {
  id          String              @id @default(uuid())
  vaultId     String
  householdId String
  memberId    String
  accountId   String
  type        SavingsMovementType
  amount      BigInt
  date        DateTime            @db.Date
  description String              @default("")
  createdAt   DateTime            @default(now())
  vault       SavingsVault        @relation(fields: [vaultId], references: [id])
  household   Household           @relation(fields: [householdId], references: [id])
  member      Member              @relation(fields: [memberId], references: [id])
  account     Account             @relation(fields: [accountId], references: [id])

  @@index([vaultId, date])
  @@index([accountId])
  @@index([householdId])
}

/// Cotización de referencia que carga el hogar a mano (pesos por 1 unidad de la moneda).
/// Solo sirve para mostrar el equivalente en ARS; los saldos siguen guardados en su moneda.
model ExchangeRate {
  id                String    @id @default(uuid())
  householdId       String
  currency          String
  rate              Decimal   @db.Decimal(20, 6)
  updatedAt         DateTime  @updatedAt
  updatedByMemberId String?
  household         Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, currency])
}

/// Objetivo (tope) de gastos de un mes. memberId null = meta del hogar completo; con memberId = meta de ese miembro.
/// Montos en centavos (BigInt), como el resto de la app. Gastado = suma de EXPENSE del mes en esa moneda.
/// Unicidad: 1 meta por miembro por mes (@@unique) y 1 meta de hogar por mes: índice parcial en la base
/// MonthlyGoal_household_month_key (UNIQUE householdId, year, month WHERE memberId IS NULL), creado a mano
/// porque Prisma no modela índices parciales.
model MonthlyGoal {
  id          String    @id @default(uuid())
  householdId String
  memberId    String?
  amount      BigInt
  currency    String    @default("ARS")
  month       Int
  year        Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  household   Household @relation(fields: [householdId], references: [id])
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([householdId, year, month, memberId])
  @@index([householdId, year, month])
}

enum SplitGroupStatus {
  ACTIVE
  SETTLED
}

enum SplitType {
  EQUAL
  CUSTOM
}

/// División de gastos estilo SplitWise (viaje, asado, alquiler con amigos). Es solo una calculadora:
/// NO crea Transaction ni toca saldos del hogar (salvo que el usuario toque "Pasar a movimientos").
/// Montos en centavos (BigInt) como el resto de la app. householdId en todas las tablas para RLS.
model SplitGroup {
  id                String             @id @default(uuid())
  householdId       String
  title             String
  currency          String             @default("ARS")
  status            SplitGroupStatus   @default(ACTIVE)
  createdByMemberId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  household         Household          @relation(fields: [householdId], references: [id])
  participants      SplitParticipant[]
  expenses          SplitExpense[]
  settlements       SplitSettlement[]

  @@index([householdId, createdAt])
}

/// Persona de una división: un miembro del hogar (memberId) o un nombre libre ("Juan", "Mamá").
model SplitParticipant {
  id          String            @id @default(uuid())
  householdId String
  groupId     String
  name        String
  memberId    String?
  createdAt   DateTime          @default(now())
  group       SplitGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member      Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  paid        SplitExpense[]
  settlesFrom SplitSettlement[] @relation("SettleFrom")
  settlesTo   SplitSettlement[] @relation("SettleTo")

  @@unique([groupId, name])
  @@index([householdId])
}

/// Gasto de una división. splitDetails = { mode, shares: { participantId: "centavos" }, input? }:
/// la parte de cada uno queda guardada al cargar el gasto (EQUAL entre los elegidos o CUSTOM por % / monto),
/// así sumar participantes después no cambia los gastos viejos.
model SplitExpense {
  id                  String           @id @default(uuid())
  householdId         String
  groupId             String
  description         String
  amount              BigInt
  paidByParticipantId String
  date                DateTime         @db.Date
  splitType           SplitType        @default(EQUAL)
  splitDetails        Json?
  /// Si se pasó a movimientos del hogar: id del Transaction creado (sin FK, solo para no pasarlo dos veces).
  movedTransactionId  String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now()) @updatedAt
  group               SplitGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy              SplitParticipant @relation(fields: [paidByParticipantId], references: [id], onDelete: NoAction)

  @@index([groupId, date])
  @@index([householdId])
}

/// Pago entre participantes ("Karu le pagó $5.000 a Fede"). Saca la deuda de pendientes y queda en el historial.
model SplitSettlement {
  id                String           @id @default(uuid())
  householdId       String
  groupId           String
  fromParticipantId String
  toParticipantId   String
  amount            BigInt
  createdAt         DateTime         @default(now())
  group             SplitGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from              SplitParticipant @relation("SettleFrom", fields: [fromParticipantId], references: [id], onDelete: NoAction)
  to                SplitParticipant @relation("SettleTo", fields: [toParticipantId], references: [id], onDelete: NoAction)

  @@index([groupId, createdAt])
  @@index([householdId])
}

/// Vínculo de una cuenta de la app con una cuenta real de Mercado Pago (OAuth). Una por cuenta.
/// Los tokens se guardan SOLO cifrados (AES-256-GCM con MP_TOKEN_SECRET) y nunca salen del servidor.
model MpConnection {
  id              String    @id @default(uuid())
  householdId     String
  accountId       String    @unique
  /// Quién vinculó (dueño de la cuenta).
  memberId        String
  /// Id del usuario en Mercado Pago.
  mpUserId        String
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime
  /// false si la vinculación es de una cuenta/credencial de prueba: su saldo nunca reemplaza al real.
  liveMode        Boolean   @default(true)
  /// Saldo leído de Mercado Pago (centavos). Solo lectura; null si todavía no se pudo leer.
  balance         BigInt?
  balanceCurrency String?
  /// Último error al leer el saldo (mensaje para mostrar, sin datos sensibles).
  syncError       String?
  /// Cuándo se leyó el saldo por última vez con éxito.
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  household       Household @relation(fields: [householdId], references: [id])
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([mpUserId])
}
